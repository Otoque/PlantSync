# ===========================================================================
#  RNF02 - Nenhuma credencial entra no repositorio publico.
# ===========================================================================
credentials.h
!credentials.h.example
secrets.h
*.secrets.h
.env
.env.*
!.env.example
*.key
*.pem

# Ambiente Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# Dados brutos exportados do ThingSpeak (podem conter a Read API Key na URL)
analytics/data/*.csv
analytics/data/*.json
!analytics/data/.gitkeep

# Saidas geradas pelo pipeline - reproduziveis, nao versionadas
analytics/outputs/*.png
analytics/outputs/*.csv
analytics/outputs/*.txt
!analytics/outputs/.gitkeep

# Build do Arduino / PlatformIO
.pio/
build/
*.bin
*.elf

# Sistema operacional e editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Banco local do backend (SQLite) - gerado ao rodar a API
*.db
.pytest_cache/

# Configuração do QR para a rede local e trajetos escolhidos para divulgação
/front_end/qr-publico.local.json
/front_end/mapas/publicos/

# Logs e arquivos temporarios
*.log
*.swp
*.tmp
.coverage
htmlcov/
