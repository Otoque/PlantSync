# Copie para back_end/.env. O .env nunca deve ir para o git.

# Conta inicial. A senha precisa ter ao menos 12 caracteres (sem contar espacos nas pontas).
PLANTSYNC_USUARIO=
PLANTSYNC_SENHA=
PLANTSYNC_EMPRESA_INICIAL=
# Chave longa e aleatoria da placa. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PLANTSYNC_CHAVE_DISPOSITIVO=
DATABASE_URL=
CANAL_THINGSPEAK=
CHAVE_LEITURA_THINGSPEAK=
THINGSPEAK_CHAVE_LEITURA_1234567=
PLANTSYNC_THINGSPEAK_CHAVE_1_3564689=
# Lista separada por virgula. Nao use "*": libera a API para qualquer site.
CORS_ORIGENS=
PLANTSYNC_CODIGO_MISSAO=
# Chave Fernet que criptografa os segredos do 2FA. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar a chave invalida o 2FA ja configurado das contas.
PLANTSYNC_TOTP_KEY=
# Intervalos de 30 s aceitos antes/depois do atual (0 a 2; padrao 1).
PLANTSYNC_TOTP_WINDOW=
PLANTSYNC_API_URL=
