# Copie este arquivo para .env e ajuste se precisar.

# Primeira conta do painel. Sem estas variáveis, uma instalação nova não cria o administrador.
# Escolha a sua senha, com ao menos 12 caracteres: nao use a mesma de outro servico.
# Uma senha inicial mais curta impede a criação da primeira conta.
PLANTSYNC_USUARIO=
PLANTSYNC_SENHA=

# Nome da organização criada com a primeira conta. Pode ser alterado depois no painel.
# As credenciais acima inicializam a conta. Trocas posteriores de senha usam o painel.
PLANTSYNC_EMPRESA_INICIAL=

# Chave da placa para buscar a faixa do lote, com ao menos 32 caracteres e sem acento. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# e grave a mesma chave no credentials.h da placa. Sem ela, a rota da placa responde 503.
PLANTSYNC_CHAVE_DISPOSITIVO=

# Os valores abaixo sao opcionais.

# DATABASE_URL=sqlite:///plantsync.db
# CANAL_THINGSPEAK=3493443
# As duas opções seguintes pertencem ao contrato legado, anterior à API v1:
# CHAVE_LEITURA_THINGSPEAK=
# THINGSPEAK_CHAVE_LEITURA_1234567=
# Na API por empresa, a chave de leitura privada inclui a empresa e o canal.
# Exemplo para empresa 1, canal 3564689, preenchido somente no ambiente local:
# PLANTSYNC_THINGSPEAK_CHAVE_1_3564689=
# CORS_ORIGENS=http://localhost:5500,http://127.0.0.1:5500
