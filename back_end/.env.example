# Copie este arquivo para .env e ajuste se precisar.

# Login do painel. Sem estas duas variaveis a API sobe, mas ninguem consegue entrar.
# Escolha a sua senha, com ao menos 12 caracteres: nao use a mesma de outro servico.
# Com senha mais curta, a API tambem sobe, mas ninguem consegue entrar.
PLANTSYNC_USUARIO=
PLANTSYNC_SENHA=

# Chave da placa para buscar a faixa do lote, com ao menos 32 caracteres e sem acento. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# e grave a mesma chave no credentials.h da placa. Sem ela, a rota da placa responde 503.
PLANTSYNC_CHAVE_DISPOSITIVO=

# Os valores abaixo sao opcionais.

# DATABASE_URL=sqlite:///plantsync.db
# CANAL_THINGSPEAK=3493443
# CHAVE_LEITURA_THINGSPEAK=
# CORS_ORIGENS=http://localhost:5500,http://127.0.0.1:5500
