#ifndef CREDENTIALS_H
#define CREDENTIALS_H

/* ===========================================================================
 *  MODELO DE CREDENCIAIS - RNF02
 *
 *  Copie este arquivo para "credentials.h" na mesma pasta e preencha os
 *  valores reais. O arquivo credentials.h esta no .gitignore e NUNCA e
 *  versionado, para evitar vazamento de chaves em repositorio publico.
 *
 *  No simulador Wokwi use exatamente:
 *      SSID .: "Wokwi-GUEST"
 *      Senha : "" (vazia)
 * ===========================================================================
 */

// ---------------------------------------------------------------------------
// REDE
// ---------------------------------------------------------------------------
#define WIFI_SSID           "NOME_DA_REDE"
#define WIFI_PASSWORD       "SENHA_DA_REDE"

// ---------------------------------------------------------------------------
// TRANSPORTE HTTP - ThingSpeak
// ---------------------------------------------------------------------------
// Write API Key do canal ThingSpeak da equipe
#define THINGSPEAK_API_KEY  "SUA_THINGSPEAK_API_KEY_AQUI"

// ---------------------------------------------------------------------------
// TRANSPORTE MQTT (v3)
// ---------------------------------------------------------------------------
/*  OPCAO A - Broker generico (recomendado para o trabalho de MQTT)
 *
 *  Permite topicos hierarquicos, Last Will and Testament e retain, que sao
 *  justamente os recursos que diferenciam o MQTT do HTTP. O broker publico
 *  abaixo foi usado nos ensaios de medicao e apresenta certificado assinado
 *  por autoridade publicamente confiavel.
 *
 *  Em producao, substituir por broker proprio (Mosquitto em contentor) com
 *  autenticacao por usuario e senha e certificado da equipe.
 */
#define MQTT_HOST           "broker.emqx.io"
#define MQTT_PORTA          8883

/*  Autenticacao do broker. O broker publico de ensaio aceita conexao anonima;
 *  deixe as duas linhas comentadas nesse caso. Em broker proprio, descomente
 *  e preencha -- o firmware detecta MQTT_USUARIO e passa a autenticar.
 */
// #define MQTT_USUARIO     "usuario_do_broker"
// #define MQTT_SENHA       "senha_do_broker"

/*  Certificado raiz do broker, para fixacao (certificate pinning).
 *
 *  Enquanto MQTT_CA_CERT nao for definido, o firmware recorre a
 *  setInsecure(), que aceita qualquer certificado. Isso e aceitavel no
 *  ensaio comparativo, mas CONTRARIA O RNF02 em operacao. Antes da entrega
 *  final, cole aqui o certificado em formato PEM:
 *
 *  #define MQTT_CA_CERT R"EOF(
 *  -----BEGIN CERTIFICATE-----
 *  ...
 *  -----END CERTIFICATE-----
 *  )EOF"
 */

/*  OPCAO B - MQTT nativo do ThingSpeak
 *
 *  Reaproveita o canal 3493443 e a base historica ja coletada, mas o
 *  ThingSpeak impoe a estrutura de topico "channels/<id>/publish" e payload
 *  em query string, sem LWT e sem retain. Para usar, defina MQTT_THINGSPEAK
 *  no main.ino e preencha as credenciais abaixo.
 *
 *  As credenciais MQTT do ThingSpeak sao DISTINTAS da Write API Key. Para
 *  obte-las: ThingSpeak > Devices > MQTT > Add a new device. O portal exibe
 *  Client ID, Username e Password UMA UNICA VEZ, no momento da criacao.
 */
// #define MQTT_HOST         "mqtt3.thingspeak.com"
// #define MQTT_PORTA        8883
// #define MQTT_CLIENT_ID    "CLIENT_ID_DO_THINGSPEAK"
// #define MQTT_USUARIO      "USERNAME_DO_THINGSPEAK"
// #define MQTT_SENHA        "PASSWORD_DO_THINGSPEAK"
// #define THINGSPEAK_CANAL  "3493443"

#endif
